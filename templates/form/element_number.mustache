{{!
    @template mod_projetvet/form/element_number

    Number input form element.

    Context variables required for this template:
    * label - The element label
    * required - Whether the element is required
    * advanced - Whether the element is marked as advanced
    * helpbutton - Help button HTML
    * error - Error message, if any
    * element - Element context from number_element::export_for_template()
        * id - The element id
        * wrapperid - The element wrapper id
        * iderror - The error message container id
        * name - The element name
        * value - The current value
        * frozen - Whether the element is frozen
        * hardfrozen - Whether the element is hard frozen
        * min - Minimum value (optional)
        * max - Maximum value (optional)
        * step - Step increment (optional)
        * action - Suggestion action (optional)
        * string - String identifier for suggestions (optional)
        * attributes - Any additional HTML attributes

    Example context (json):
    {
        "label": "Number of hours",
        "required": true,
        "advanced": false,
        "helpbutton": "",
        "error": null,
        "element": {
            "id": "id_field_123",
            "wrapperid": "fitem_id_field_123",
            "iderror": "id_error_field_123",
            "name": "field_123",
            "type": "number",
            "value": "42",
            "frozen": false,
            "hardfrozen": false,
            "min": "0",
            "max": "100",
            "step": "1",
            "action": "suggestedects",
            "string": "suggestedects_hours",
            "attributes": ""
        }
    }
}}
{{< core_form/element-template }}
    {{$element}}
    <input type="number"
        class="form-control {{#error}}is-invalid{{/error}}"
        name="{{element.name}}"
        {{#element.frozen}}
            readonly {{#element.hardfrozen}}disabled{{/element.hardfrozen}}
        {{/element.frozen}}
        id="{{element.id}}"
        value="{{element.value}}"
        {{#element.min}}min="{{element.min}}"{{/element.min}}
        {{#element.max}}max="{{element.max}}"{{/element.max}}
        {{#element.step}}step="{{element.step}}"{{/element.step}}
        {{! Use a plugin-specific attribute name instead of data-action because core_form/modalform's
           disableButtons() selector "[data-action]" would otherwise match this input and set
           disabled="true" right before form.serialize(), causing the field to be dropped from the
           submitted data and triggering "You must supply a value here." on every submit. }}
        {{#element.action}}data-projetvet-action="{{element.action}}"{{/element.action}}
        {{#element.string}}data-projetvet-string="{{element.string}}"{{/element.string}}
        {{#error}}
           autofocus aria-describedby="{{element.iderror}}"
        {{/error}}
        {{#required}}
           aria-required="true"
        {{/required}}
        {{{element.attributes}}} >
        {{#element.action}}
            <div class="mt-1 text-muted" id="{{element.id}}_suggestion"></div>
        {{/element.action}}
    {{/element}}
{{/ core_form/element-template }}
