{{!
    @template mod_projetvet/form/element_switch

    Template for switch form element

    Example context (json):
    {
        "element": {
            "id": "id_submitted",
            "name": "submitted",
            "value": "1",
            "checked": true,
            "text": "Send to teacher"
        },
        "label": "Submit",
        "required": false,
        "error": ""
    }
}}
{{< core_form/element-template }}
    {{$element}}
        <div class="form-check form-switch" data-fieldtype="switch">
            {{! Hidden field to ensure 0 is sent when checkbox is unchecked }}
            <input type="hidden" name="{{element.name}}" value="0">
            <input type="checkbox"
                   role="switch"
                   class="form-check-input"
                   id="{{element.id}}"
                   name="{{element.name}}"
                   value="{{element.value}}"
                   {{#element.frozen}}disabled{{/element.frozen}}
                   {{#element.checked}}checked{{/element.checked}}
                   {{#element.dataattributes}}data-{{name}}="{{value}}" {{/element.dataattributes}}>
            <label class="form-check-label" for="{{element.id}}">
                {{element.text}}
            </label>
        </div>
    {{/element}}
{{/ core_form/element-template }}
